# ------------------------------------------------------------------
# Khan Travel – B2B Partner Registration
# Copy this file to `.env` and fill in the values.
# Real server environment variables (SetEnv / hosting panel) take
# precedence over values in this file.
# NEVER commit `.env` – it is git-ignored and blocked by .htaccess.
# ------------------------------------------------------------------

# production | local
APP_ENV=production
# Show PHP errors in the browser. Keep false in production.
APP_DEBUG=false
# Public base URL of this app, without trailing slash (used for canonical URLs and emails).
APP_URL=https://partners.khantravel.com
# Must match the Laravel app's `app.timezone` so created_at values line up.
APP_TIMEZONE=UTC

# Khan Travel main website ("Back to Khan Travel" buttons, footer).
MAIN_SITE_URL=https://kts-agents.de
# Privacy Policy link. Leave empty to use this app's own /privacy-policy page.
PRIVACY_POLICY_URL=
# Optional public contact email shown on the page. Leave empty to hide it.
CONTACT_EMAIL=info@kts-agents.de

# --- Database (existing TravelBookingPanel database) ---------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khantravel
DB_USERNAME=
DB_PASSWORD=

# --- Resend (transactional email) ---------------------------------
# Create/rotate the key at https://resend.com/api-keys. Never put it in JS or committed PHP.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (do not use a gmail.com address here).
MAIL_FROM=contact@travelbookingpanel.com
MAIL_FROM_NAME=Khan Travel
# Replies to the applicant confirmation email go here.
MAIL_REPLY_TO=hm.younas22@gmail.com
# Receives "New Khan Travel B2B Partner Application" notifications (comma-separate for several).
ADMIN_EMAIL=hm.younas22@gmail.com,contact@travelbookingpanel.com
# Optional absolute HTTPS URL of the email logo. Leave empty to embed
# assets/images/khan-travel-logo-email.png inside each email (works everywhere, also locally).
LOGO_URL=
# Optional link for the "Review Application" button. `{id}` is replaced with the new user ID,
# e.g. https://admin.khantravel.com/admin/agents/{id}. Leave empty to hide the button.
ADMIN_REVIEW_URL=
# Write a copy of every outgoing email to storage/mail-preview/ (useful locally).
MAIL_PREVIEW=false

# --- Friendly Captcha (v2) ----------------------------------------
# https://app.friendlycaptcha.eu – Applications → site key; API Keys → secret (API key).
FRIENDLY_CAPTCHA_SITE_KEY=
FRIENDLY_CAPTCHA_SECRET_KEY=
# global | eu  (use "eu" if your Friendly Captcha account is EU-hosted)
FRIENDLY_CAPTCHA_ENDPOINT=global
# Show a "CAPTCHA not configured" notice in the form (APP_ENV=local only).
FRIENDLY_CAPTCHA_SHOW_PLACEHOLDER=false

# --- Abuse protection ----------------------------------------------
# Max submission attempts per IP address within the window (seconds).
RATE_LIMIT_MAX_ATTEMPTS=8
RATE_LIMIT_WINDOW=900

# Password for the /language-settings page. Empty = page disabled. Use a long random value.
LANGUAGE_ADMIN_PASSWORD=
